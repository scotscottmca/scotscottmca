---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Not found">
  <Header />
  <main class="page">
    <div class="container lost">
      <div>
        <p class="code mono">HTTP/1.1 404 Not Found</p>
        <h1 class="page-title">This page has been decommissioned.</h1>
        <p class="lede">Or it never existed. Either way, it isn't answering.</p>
        <p class="cta"><a class="btn" href="/"><Icon name="arrow-left" />Back home</a></p>
      </div>
      <img
        class="pixel"
        src="/images/emotes/internet-explorer.png"
        alt="Pixel-art Scott hoisting the Internet Explorer logo overhead next to a recycling bin"
        width="240"
        height="240"
      />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .lost {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 56px;
    align-items: center;
    padding-top: 40px;
  }
  .code {
    margin: 0 0 16px;
    color: var(--cyan);
  }
  .cta {
    margin: 32px 0 0;
  }
  @media (max-width: 720px) {
    .lost {
      grid-template-columns: minmax(0, 1fr);
    }
    .lost img {
      width: 160px;
    }
  }
</style>
