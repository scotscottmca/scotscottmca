---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const recent = posts.slice(0, 6);
---

<BaseLayout>
  <Header />
  <main>
    <div class="container">
      <section class="hero">
        <img class="avatar" src={SITE.avatar} alt={SITE.author} width="110" height="110" />
        <h1><span class="gradient-text">{SITE.title}</span></h1>
        <p>{SITE.subtitle}</p>
        <SocialLinks />
      </section>

      <h2 class="section-title">Latest posts</h2>
      <ul class="post-list">
        {recent.map((post) => <PostCard post={post} />)}
      </ul>

      {
        posts.length > recent.length && (
          <p style="margin-top:1.5rem">
            <a href="/posts">View all {posts.length} posts →</a>
          </p>
        )
      }
    </div>
  </main>
  <Footer />
</BaseLayout>
