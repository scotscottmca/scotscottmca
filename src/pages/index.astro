---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE } from '../config';

// Rough flavor-text uptime, computed at build time — not meant to be exact.
const start = new Date(SITE.since, 0, 1);
const diffDays = Math.floor((Date.now() - start.getTime()) / 86400000);
const uptime = `${String(Math.floor(diffDays / 365)).padStart(2, '0')}Y ${diffDays % 365}D`;

const telemetry = [
  {
    label: 'Currently',
    value: 'Piping live from the Status page once it ships',
    dot: 'live',
    chip: 'LIVE',
  },
  {
    label: 'Toolbox',
    value: 'C#/.NET, TypeScript/React, Azure & Terraform, PowerShell — plus a growing pile of AI/agent tooling',
    dot: 'on',
    icon: { src: '/images/emotes/clippy.png', alt: 'Illustration of Scott holding Clippy the Office assistant overhead' },
  },
  {
    label: 'Fuel',
    value: 'Black coffee and weird beers',
    dot: 'on',
  },
  {
    label: 'Off the clock',
    value: 'Dachshunds, video games, and doomscrolling AI slop',
    dot: 'on',
  },
];
---

<BaseLayout>
  <Header />
  <main>
    <div class="container">
      <div class="statusstrip">
        <span class="led"></span>
        <span class="title">Fleet status · {SITE.title}</span>
        <span class="meta">Uptime {uptime} · All systems nominal</span>
      </div>

      <div class="hero">
        <div class="badge">
          <div class="badge-row"><span class="led" style="animation:none"></span> Status: Online</div>
          <p class="badge-name">{SITE.author}</p>
          <p class="badge-role">Software Developer // AI Janitor</p>
          <div class="badge-tags">
            <span><b>Clearance</b> — Public</span>
            <span><b>Base</b> — Larkhall, Scotland</span>
          </div>
        </div>
        <div class="log">
          <p class="eyebrow">Log entry // {SITE.author}</p>
          <p>
            {/* TODO(content): 2-4 sentence intro — swap this placeholder for a short bio. */}
            Hi, I'm Scott. This is placeholder intro copy — swap it for a short entry
            covering who you are, what you work on day to day, and what readers can
            expect to find on this console.
          </p>
        </div>
      </div>

      <div style="margin:0.2rem 0 0.4rem">
        <SocialLinks />
      </div>

      <div class="section-heading">Live telemetry <span class="rule"></span></div>
      <div class="feed">
        {telemetry.map((t) => (
          <div class="feed-row">
            <span class={`dot ${t.dot}`}></span>
            <span class="feed-label">{t.label}</span>
            <span class="feed-value">
              {t.value}
              {t.chip && <span class="chip">{t.chip}</span>}
              {t.icon && (
                <img class="site-mascot" src={t.icon.src} alt={t.icon.alt} width="24" height="24" style="margin-left:0.35rem" />
              )}
            </span>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
