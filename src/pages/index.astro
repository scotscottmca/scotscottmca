---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import LiveStateTile from '../components/LiveStateTile.astro';
import { SITE } from '../config';
import { HEADLINE_FIGURES, FIGURES_PERIOD, ROLE } from '../data/cv';
import { formatDate } from '../utils';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);
const releases = await getCollection('releases', ({ data }) => !data.draft);
const latestRelease = [...releases].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)[0];

const telemetry: { label: string; value: string; href?: string }[] = [
  {
    label: 'Toolbox',
    value: 'C#/.NET, TypeScript/React, Azure & Terraform, PowerShell — plus a growing pile of AI/agent tooling',
  },
  { label: 'Fuel', value: 'Black coffee and weird beers' },
  { label: 'Off the clock', value: 'Dachshunds, video games, and doomscrolling AI slop' },
];

if (latestRelease) {
  telemetry.push({
    label: 'Latest release',
    value: `${latestRelease.data.product} ${latestRelease.data.version} · ${formatDate(latestRelease.data.date)}`,
    href: `/releases/${latestRelease.id.split('/')[0]}`,
  });
}
---

<BaseLayout>
  <Header />
  <main>
    <div class="container">
      <!-- Two columns, separated by space rather than by borders. -->
      <div class="ledger">
        <div class="ledger-left">
          <LiveStateTile />

          <section class="who">
            <h1 class="who-name">{SITE.author}</h1>
            <p class="who-role">Software Developer <span aria-hidden="true">//</span> AI Janitor</p>
            <dl class="who-facts">
              <div>
                <dt>Base</dt>
                <dd>{ROLE.location}</dd>
              </div>
              <div>
                <dt>Post</dt>
                <dd>{ROLE.org}</dd>
              </div>
            </dl>

            <a class="who-figures" href="/cv">
              <span class="figures-row">
                {
                  HEADLINE_FIGURES.map((figure) => (
                    <span class="figure">
                      <span class="figure-value">{figure.value}</span>
                      <span class="figure-unit">{figure.unit}</span>
                    </span>
                  ))
                }
                <span class="tag figures-period">{FIGURES_PERIOD}</span>
              </span>
              <span class="who-figures-drill">Full CV</span>
            </a>

            <SocialLinks />
          </section>

        </div>

        <div class="ledger-right">
          <section class="work-panel">
            <h2 class="ledger-heading">Personal projects</h2>
            <ol class="work">
              {
                projects.map((project) => (
                  <li>
                    <a href={`/projects/${project.id}/`}>
                      <span class="work-head">
                        <span class="work-name">{project.data.title}</span>
                        <span class={`status status-${project.data.status}`}>{project.data.status}</span>
                      </span>
                      <span class="work-summary">{project.data.summary}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </section>

        </div>
      </div>

      <div class="section-heading">Telemetry <span class="rule"></span></div>
      <section class="telemetry">
        <dl>
          {
            telemetry.map((t) => (
              <div class="telemetry-row">
                <span class="dot" />
                <dt>{t.label}</dt>
                <dd>{t.href ? <a href={t.href}>{t.value}</a> : t.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
