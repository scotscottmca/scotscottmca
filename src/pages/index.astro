---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import LiveStateTile from '../components/LiveStateTile.astro';
import { SITE } from '../config';
import { HEADLINE_FIGURES, FIGURES_PERIOD, ROLE } from '../data/cv';
import { formatDate } from '../utils';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);
const releases = await getCollection('releases', ({ data }) => !data.draft);
const latestRelease = [...releases].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)[0];

const telemetry = [
  {
    label: 'Toolbox',
    value: 'C#/.NET, TypeScript/React, Azure & Terraform, PowerShell — plus a growing pile of AI/agent tooling',
  },
  { label: 'Fuel', value: 'Black coffee and weird beers' },
  { label: 'Off the clock', value: 'Dachshunds, video games, and doomscrolling AI slop' },
];
---

<BaseLayout>
  <Header />
  <main>
    <div class="container container-wide">
      <!-- Three columns: who, what right now, and the readouts. Projects run
           the full width beneath them. -->
      <div class="ledger">
        <section class="who">
          <h1 class="who-name">{SITE.author}</h1>
          <p class="who-role">Software Developer <span aria-hidden="true">//</span> AI Janitor</p>
          <dl class="who-facts">
            <div>
              <dt>Base</dt>
              <dd>{ROLE.location}</dd>
            </div>
            <div>
              <dt>Post</dt>
              <dd>{ROLE.org}</dd>
            </div>
          </dl>

          <a class="who-figures" href="/cv">
            <span class="figures-row">
              {
                HEADLINE_FIGURES.map((figure) => (
                  <span class="figure">
                    <span class="figure-value">{figure.value}</span>
                    <span class="figure-unit">{figure.unit}</span>
                  </span>
                ))
              }
              <span class="tag figures-period">{FIGURES_PERIOD}</span>
            </span>
            <span class="who-figures-drill">Full CV</span>
          </a>

          <SocialLinks />
        </section>

        <LiveStateTile />

        <section class="telemetry">
          <h2 class="ledger-heading">Telemetry</h2>
          <dl>
            {
              telemetry.map((t) => (
                <div class="telemetry-row">
                  <dt>
                    <span class="dot" />
                    {t.label}
                  </dt>
                  <dd>{t.value}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="work-panel">
          <div class="work-bar">
            <h2 class="ledger-heading">Personal projects</h2>
            {
              latestRelease && (
                <p class="work-latest">
                  Latest release{' '}
                  <a href={`/releases/${latestRelease.id.split('/')[0]}`}>
                    {latestRelease.data.product} {latestRelease.data.version}
                  </a>
                  <span class="work-latest-date">
                    <time datetime={latestRelease.data.date.toISOString()}>
                      {formatDate(latestRelease.data.date)}
                    </time>
                  </span>
                </p>
              )
            }
          </div>
          <ol class="work">
            {
              projects.map((project) => (
                <li>
                  <a href={`/projects/${project.id}/`}>
                    <span class="work-head">
                      <span class="work-name">{project.data.title}</span>
                      <span class={`status status-${project.data.status}`}>{project.data.status}</span>
                    </span>
                    <span class="work-summary">{project.data.summary}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
