---
import fs from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Unlisted: no nav link, noindex, out of the sitemap. The five status
// blueprints drawing themselves with anime.js: every stroke is run by
// svg.createDrawable on one timeline, and a createDraggable knob scrubs it.

// Tone and period per state, as in scripts/status-sprites.mjs. Each sprite's
// own <style> is stripped (five copies would fight over the same class names)
// and replaced by the scoped rules below, driven by --tone and --period.
const states = [
  { key: 'asleep', word: 'Asleep', tone: '#b794ff', period: '4.8s' },
  { key: 'awake', word: 'Awake', tone: '#00d4ff', period: '2.4s' },
  { key: 'walking', word: 'Out walking', tone: '#00d4ff', period: '1.4s' },
  { key: 'working-out', word: 'Working out', tone: '#00d4ff', period: '0.9s' },
  { key: 'active', word: 'Up and active', tone: '#00d4ff', period: '1.6s' },
].map((s) => ({
  ...s,
  svg: fs
    .readFileSync(new URL(`../../public/images/status/scott-${s.key}.svg`, import.meta.url), 'utf8')
    .replace(/<!--[\s\S]*?-->/, '')
    .replace(/<style>[\s\S]*?<\/style>/, '')
    .replace(' width="240" height="240"', ''),
}));
---

<BaseLayout title="Lab" description="The status blueprints drawing themselves." noindex>
  <Header />
  <main class="page">
    <div class="container lab">
      <header class="lab-head">
        <p class="lab-kicker">lab / anime.js 4.5</p>
        <h1 class="page-title">The blueprints draw themselves</h1>
        <p class="lede">All five status sprites, every stroke run by <code>svg.createDrawable</code> on one timeline. Drag the knob to scrub it. Reduced motion shows them finished.</p>
      </header>

      <div class="scrub" data-scrub>
        <div class="scrub-track" data-track><button type="button" class="scrub-knob" data-knob aria-label="Scrub the drawing"></button></div>
        <div class="scrub-meta">
          <button type="button" class="scrub-btn" data-toggle>pause</button>
          <span class="scrub-time" data-time>0.00s</span>
        </div>
      </div>

      <ul class="bps">
        {states.map((s) => (
          <li class="bp-card" style={`--tone: ${s.tone}; --period: ${s.period}`}>
            <div class="bp" data-bp set:html={s.svg} />
            <p class="bp-label"><span class="bp-key">{s.key}</span>{s.word}</p>
          </li>
        ))}
      </ul>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { createTimeline, createDraggable, stagger, svg } from 'animejs';

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const $ = (sel: string, root: ParentNode = document) => root.querySelector(sel) as HTMLElement;
    const sprites = Array.from(document.querySelectorAll('[data-bp]'));
    const sync: { fn?: (t: any) => void } = {};
    const tl = createTimeline({ loop: true, loopDelay: 2000, defaults: { ease: 'inOutQuad' }, onUpdate: (t) => sync.fn?.(t) });

    // Each sprite starts 450ms after the one before; within a sprite the strokes
    // draw first, then the fills, dots and callouts in that order.
    sprites.forEach((el, i) => {
      const at = i * 450;
      tl.add(svg.createDrawable(el.querySelectorAll('path, rect, line')), { draw: ['0 0', '0 1'], duration: 900, delay: stagger(70) }, at)
        .add(el.querySelectorAll('.s'), { fillOpacity: [0, 0.06], duration: 600 }, at + 1500)
        .add(el.querySelectorAll('circle, ellipse'), { scale: [0, 1], opacity: [0, 1], duration: 280, delay: stagger(60) }, at + 1800)
        .add(el.querySelectorAll('text'), { opacity: [0, 1], y: [4, 0], duration: 320, delay: stagger(50) }, at + 2000);
    });

    // The knob seeks the timeline while dragged and follows it while it plays.
    const root = $('[data-scrub]');
    const knob = $('[data-knob]', root);
    const time = $('[data-time]', root);
    const toggle = $('[data-toggle]', root);
    let dragging = false;
    const drag = createDraggable(knob, {
      container: $('[data-track]', root),
      containerPadding: 3,
      y: false,
      maxVelocity: 0,
      onGrab: () => {
        dragging = true;
        tl.pause();
        toggle.textContent = 'play';
      },
      // seek(), not the iterationCurrentTime setter: that one ignores loopDelay and lands late on later loops.
      onDrag: (d: any) => tl.seek(d.progressX * tl.iterationDuration),
      onRelease: () => {
        dragging = false;
      },
    });
    toggle.addEventListener('click', () => {
      tl.paused ? tl.play() : tl.pause();
      toggle.textContent = tl.paused ? 'play' : 'pause';
    });
    sync.fn = (t) => {
      if (!dragging) drag.progressX = t.iterationProgress;
      time.textContent = (t.iterationCurrentTime / 1000).toFixed(2) + 's';
    };
  }
</script>

<style>
  .lab {
    max-width: 760px;
  }
  .lab-head {
    margin-bottom: 32px;
  }
  .lab-kicker {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--cyan);
  }
  .lede code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text);
  }

  /* The scrubber: a track, a knob, play/pause and the clock. */
  .scrub {
    margin-bottom: 32px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .scrub-track {
    position: relative;
    height: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .scrub-track::before {
    content: '';
    position: absolute;
    inset: 13px 8px;
    background: var(--line-hi);
  }
  .scrub-knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 1px solid var(--cyan);
    border-radius: 4px;
    background: var(--ink);
    cursor: grab;
    touch-action: none;
  }
  .scrub-knob:active {
    cursor: grabbing;
    background: var(--cyan);
  }
  .scrub-meta {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    color: var(--muted);
  }
  .scrub-btn {
    padding: 0;
    border: 0;
    background: none;
    color: var(--cyan);
    font: inherit;
    cursor: pointer;
  }

  /* The five blueprints on gridded insets, as on /status. */
  .bps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
  }
  .bp-card {
    margin: 0;
  }
  .bp {
    aspect-ratio: 1;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background:
      linear-gradient(color-mix(in srgb, var(--tone) 10%, transparent) 1px, transparent 1px) 0 0 / 100% 10%,
      linear-gradient(90deg, color-mix(in srgb, var(--tone) 10%, transparent) 1px, transparent 1px) 0 0 / 10% 100%,
      var(--ink);
  }
  .bp :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .bp-label {
    margin: 8px 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .bp-key {
    color: var(--tone);
    margin-right: 10px;
  }

  /* The sprites' own stylesheet, scoped and parameterised. Fills, dots and
     callouts start hidden: anime only writes a tween's value once the
     playhead reaches it, so until then the CSS value shows. */
  .bp :global(.s) {
    fill: var(--tone);
    fill-opacity: 0;
    stroke: var(--tone);
    stroke-width: 0.8;
    stroke-linejoin: round;
  }
  .bp :global(.line),
  .bp :global(.p) {
    fill: none;
    stroke: var(--tone);
    stroke-width: 0.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bp :global(.dot) {
    fill: var(--tone);
  }
  .bp :global(.dim) {
    opacity: 0.7;
  }
  .bp :global(text) {
    font-family: var(--font-mono);
    font-weight: 700;
    opacity: 0;
  }
  .bp :global(.note line),
  .bp :global(.guide) {
    stroke: var(--faint);
    stroke-width: 0.4;
    fill: none;
  }
  .bp :global(.guide) {
    stroke-dasharray: 1.5 1.5;
  }
  .bp :global(.note text) {
    font-size: 5.2px;
    font-weight: 400;
    fill: var(--muted);
  }
  .bp :global(circle),
  .bp :global(ellipse) {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
  }
  .bp :global(.fig) {
    animation: bob var(--period) ease-in-out infinite;
  }
  .bp :global(.z) {
    animation: rise var(--period) ease-out infinite;
  }
  .bp :global(.z2) {
    animation-delay: calc(var(--period) / 2);
  }
  .bp :global(.steam) {
    animation: steam var(--period) ease-in-out infinite;
  }
  .bp :global(.reps) {
    animation: reps var(--period) ease-in-out infinite;
  }
  .bp :global(.trot) {
    animation: reps calc(var(--period) * 2) ease-in-out infinite;
  }
  .bp :global(.beat) {
    animation: beat var(--period) ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(-1.5px);
    }
  }
  @keyframes rise {
    0% {
      opacity: 0;
      transform: translate(0, 4px);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(3px, -6px);
    }
  }
  @keyframes steam {
    0%,
    100% {
      opacity: 0.2;
      transform: translateY(1px);
    }
    50% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }
  @keyframes reps {
    50% {
      transform: translateY(-7px);
    }
  }
  @keyframes beat {
    0%,
    60%,
    100% {
      transform: scale(1);
    }
    20% {
      transform: scale(1.18);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bp :global(*) {
      animation: none !important;
    }
    .bp :global(.s) {
      fill-opacity: 0.06;
    }
    .bp :global(text),
    .bp :global(circle),
    .bp :global(ellipse) {
      opacity: 1;
    }
    .scrub {
      display: none;
    }
  }
</style>
