---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Unlisted: no nav link, noindex, out of the sitemap. Mock-ups of the
// wordmark rendering in, each one a different idea of "technology". All
// anime.js; each card loops on its own and has a replay.
const mocks = [
  { key: 'decode', how: 'scrambleText · shades charset · resolves left to right' },
  { key: 'prompt', how: 'typed at a terminal · block caret · steps easing' },
  { key: 'raster', how: 'canvas · scanned in cell by cell · pixelated' },
  { key: 'crt', how: 'colour fringes settle · scanline sweep · steps jitter' },
  { key: 'link', how: 'splitText · glyphs link in from scatter · steps easing' },
  { key: 'trace', how: 'packets ride circuit traces · createMotionPath · parts light up' },
];
---

<BaseLayout title="Lab" description="Mock-ups of the wordmark rendering in." noindex>
  <Header />
  <main class="page">
    <div class="container lab">
      <header class="lab-head">
        <p class="lab-kicker">lab / anime.js 4.5</p>
        <h1 class="page-title">Six ways in</h1>
        <p class="lede">The wordmark rendering in. Each card is one idea; they loop, or hit replay.</p>
      </header>

      <div class="mocks">
        {mocks.map((m, i) => (
          <figure class="mock" data-mock={m.key}>
            <div class="stage" data-stage>
              {m.key === 'decode' && <p class="wm"><span class="tilde">~/</span><span data-text>ScotScottMcA</span></p>}
              {m.key === 'prompt' && <p class="wm"><span class="tilde">~/</span><span data-text></span><span class="caret" data-caret></span></p>}
              {m.key === 'raster' && <canvas class="raster" data-canvas aria-label="ScotScottMcA"></canvas>}
              {m.key === 'crt' && (
                <p class="wm crt" data-crt>
                  <span class="ghost ghost-c" aria-hidden="true" data-ghost-c>~/ScotScottMcA</span>
                  <span class="ghost ghost-v" aria-hidden="true" data-ghost-v>~/ScotScottMcA</span>
                  <span class="face"><span class="tilde">~/</span>ScotScottMcA</span>
                  <span class="scanline" aria-hidden="true" data-scanline></span>
                </p>
              )}
              {m.key === 'link' && (
                <>
                  <p class="wm"><span class="tilde">~/</span><span data-text>ScotScottMcA</span></p>
                  <p class="status" data-status aria-hidden="true">linking 0/12 objects</p>
                </>
              )}
              {m.key === 'trace' && (
                <svg class="traces" viewBox="0 0 360 120" role="img" aria-label="ScotScottMcA">
                  <g class="wire" fill="none">
                    <path data-trace d="M-4 112 H 40 V 84 H 58" />
                    <path data-trace d="M-4 10 H 96 V 60 Q 96 84 118 84 H 132" />
                    <path data-trace d="M364 112 H 300 V 84 H 258" />
                  </g>
                  <g class="pads">
                    <circle cx="58" cy="84" r="2.5" /><circle cx="132" cy="84" r="2.5" /><circle cx="258" cy="84" r="2.5" />
                  </g>
                  <g class="word">
                    <text class="tilde-svg" x="22" y="64">~/</text>
                    <text data-part x="60" y="64">Scot</text>
                    <text data-part x="134" y="64">Scott</text>
                    <text data-part x="224" y="64">McA</text>
                  </g>
                  <g class="packets">
                    <circle data-pkt r="3" /><circle data-pkt r="3" /><circle data-pkt r="3" />
                  </g>
                </svg>
              )}
            </div>
            <figcaption>
              <span class="mock-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="mock-key">{m.key}</span>
              <span class="mock-how">{m.how}</span>
              <button type="button" class="replay" data-replay>replay</button>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { animate, createTimeline, stagger, steps, svg, utils } from 'animejs';
  import { splitText, scrambleText } from 'animejs/text';

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const WORD = 'ScotScottMcA';
  const css = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  const loop = { loop: true, loopDelay: 2600 };
  const card = (key: string) => document.querySelector(`[data-mock="${key}"]`) as HTMLElement;
  const $ = (sel: string, root: ParentNode) => root.querySelector(sel) as HTMLElement;
  const players: Record<string, { restart: () => any; seek: (t: number) => any; pause: () => any; duration: number }> = {};

  // 01 · decode: random glyphs resolve into the word, left to right.
  {
    const el = $('[data-text]', card('decode'));
    players.decode = animate(el, {
      innerHTML: scrambleText({ chars: 'shades', from: 'left', revealRate: 24, settleDuration: 500, revealDelay: 300 }),
      ...loop,
    });
  }

  // 02 · prompt: typed one glyph at a time, the caret riding the end.
  {
    const root = card('prompt');
    const el = $('[data-text]', root);
    const n = { v: 0 };
    players.prompt = animate(n, {
      v: WORD.length,
      ease: steps(WORD.length),
      duration: WORD.length * 95,
      delay: 500,
      onUpdate: () => (el.textContent = WORD.slice(0, Math.round(n.v))),
      ...loop,
    });
  }

  // 03 · raster: the word rendered to a tiny canvas, then painted on cell by
  // cell in scan order with a cyan beam at the head. Pixels stay pixels.
  {
    const canvas = $('[data-canvas]', card('raster')) as HTMLCanvasElement;
    const off = document.createElement('canvas');
    const octx = off.getContext('2d')!;
    const font = `700 13px ${css('--font-mono')}`;
    octx.font = font;
    const tilde = '~/';
    const tw = octx.measureText(tilde).width;
    const W = Math.ceil(octx.measureText(tilde + WORD).width) + 2;
    const H = 16;
    off.width = W;
    off.height = H;
    octx.font = font;
    octx.textBaseline = 'top';
    octx.fillStyle = '#fff';
    octx.fillText(tilde + WORD, 1, 1);
    const a = octx.getImageData(0, 0, W, H).data;
    const cells: [number, number][] = [];
    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) if (a[(y * W + x) * 4 + 3] > 120) cells.push([x, y]);
    canvas.width = W;
    canvas.height = H;
    canvas.style.width = `-epx`;
    const ctx = canvas.getContext('2d')!;
    const paint = (upto: number) => {
      ctx.clearRect(0, 0, W, H);
      for (let i = 0; i < Math.min(upto, cells.length); i++) {
        const [x, y] = cells[i];
        ctx.fillStyle = i > upto - 14 ? css('--cyan') : x < tw ? css('--violet-text') : css('--text');
        ctx.fillRect(x, y, 1, 1);
      }
    };
    const n = { v: 0 };
    players.raster = animate(n, {
      v: cells.length + 14,
      ease: 'linear',
      duration: 2200,
      delay: 300,
      onUpdate: () => paint(Math.round(n.v)),
      ...loop,
    });
    paint(0);
  }

  // 04 · crt: cyan and violet fringes jitter either side of the face, a
  // scanline sweeps once, then everything snaps into register.
  {
    const root = card('crt');
    const jitter = (s: number) => [
      { to: 14 * s, duration: 90 },
      { to: -9 * s, duration: 70 },
      { to: 6 * s, duration: 110 },
      { to: -3 * s, duration: 80 },
      { to: 1 * s, duration: 120 },
      { to: 0, duration: 60 },
    ];
    players.crt = createTimeline({ defaults: { ease: steps(1, true) }, ...loop })
      .add($('[data-ghost-c]', root), { x: jitter(1), opacity: [{ to: 0.9, duration: 400 }, { to: 0, duration: 140 }] }, 0)
      .add($('[data-ghost-v]', root), { x: jitter(-1), opacity: [{ to: 0.9, duration: 400 }, { to: 0, duration: 140 }] }, 0)
      .add($('.face', root), { opacity: [{ to: 0.35, duration: 60 }, { to: 1, duration: 60 }, { to: 0.6, duration: 80 }, { to: 1, duration: 60 }], skewX: [{ to: -6, duration: 90 }, { to: 3, duration: 110 }, { to: 0, duration: 60 }] }, 0)
      .add($('[data-scanline]', root), { y: [-12, 72], opacity: [{ to: 0.8, duration: 20 }, { to: 0, duration: 400 }], ease: 'linear', duration: 520 }, 40);
  }

  // 05 · link: the glyphs arrive from scatter in a random order, in chunky
  // steps, while a status line counts them in.
  {
    const root = card('link');
    const { chars } = splitText($('[data-text]', root), { chars: true });
    const status = $('[data-status]', root);
    const count = { v: 0 };
    players.link = createTimeline({ ...loop })
      .add(chars, {
        x: [() => utils.random(-90, 90), 0],
        y: [() => utils.random(-48, 48), 0],
        rotate: [() => utils.random(-50, 50), 0],
        opacity: [0, 1],
        ease: steps(7),
        duration: 760,
        delay: stagger(65, { from: 'random', start: 200 }),
      }, 0)
      .add(count, {
        v: chars.length,
        ease: 'linear',
        duration: 760 + 65 * chars.length,
        onUpdate: () => (status.textContent = count.v >= chars.length - 0.01 ? 'linked 12/12 objects · ok' : `linking ${Math.floor(count.v)}/12 objects`),
      }, 200);
  }

  // 06 · trace: three packets ride the traces to their pads; each part of
  // the word lights when its packet lands.
  {
    const root = card('trace');
    const traces = Array.from(root.querySelectorAll('[data-trace]')) as SVGPathElement[];
    const pkts = Array.from(root.querySelectorAll('[data-pkt]')) as SVGCircleElement[];
    const parts = Array.from(root.querySelectorAll('[data-part]')) as SVGTextElement[];
    const order = [1, 0, 2];
    const tl = createTimeline({ ...loop });
    order.forEach((i, k) => {
      const at = 200 + k * 520;
      const path = svg.createMotionPath(traces[i]);
      tl.add(pkts[i], { translateX: path.translateX, translateY: path.translateY, opacity: [{ to: 1, duration: 40 }, { to: 1, duration: 760 }, { to: 0, duration: 120 }], ease: 'inOutSine', duration: 920 }, at)
        .add(parts[i], { opacity: [0, 1], translateY: [3, 0], duration: 160, ease: steps(2) }, at + 860);
    });
    players.trace = tl;
  }

  // Replay buttons; under reduced motion, everything sits at its final frame.
  for (const [key, p] of Object.entries(players)) {
    $('[data-replay]', card(key)).addEventListener('click', () => p.restart());
    if (still) p.pause().seek(p.duration);
  }
</script>

<style>
  .lab {
    max-width: 760px;
  }
  .lab-head {
    margin-bottom: 40px;
  }
  .lab-kicker {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--cyan);
  }
  .mocks {
    display: grid;
    gap: 28px;
  }
  .mock {
    margin: 0;
  }
  .stage {
    position: relative;
    height: 150px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background:
      linear-gradient(color-mix(in srgb, var(--cyan) 6%, transparent) 1px, transparent 1px) 0 0 / 100% 25px,
      linear-gradient(90deg, color-mix(in srgb, var(--cyan) 6%, transparent) 1px, transparent 1px) 0 0 / 25px 100%,
      var(--ink);
  }
  figcaption {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .mock-n {
    color: var(--violet-text);
  }
  .mock-key {
    color: var(--text);
    font-weight: 700;
  }
  .mock-how {
    flex: 1;
    min-width: 0;
  }
  .replay {
    padding: 0;
    border: 0;
    background: none;
    color: var(--cyan);
    font: inherit;
    cursor: pointer;
  }

  /* The wordmark, big. Mono 700 like the header's, with the violet tilde. */
  .wm {
    margin: 0;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: clamp(26px, 5.5vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    white-space: pre;
  }
  .tilde {
    color: var(--violet-text);
    margin-right: 0.3em;
  }
  .caret {
    width: 0.5em;
    height: 1.05em;
    margin-left: 0.12em;
    background: var(--cyan);
    animation: caret 1.06s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  /* 03 */
  .raster {
    image-rendering: pixelated;
    max-width: 92%;
    height: auto;
  }

  /* 04 */
  .crt {
    position: relative;
  }
  .crt .ghost {
    position: absolute;
    inset: 0;
    opacity: 0;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .crt .ghost-c {
    color: var(--cyan);
  }
  .crt .ghost-v {
    color: var(--violet-text);
  }
  .crt .face {
    display: inline-flex;
    align-items: center;
  }
  .crt .scanline {
    position: absolute;
    left: -8%;
    right: -8%;
    top: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
    opacity: 0;
    pointer-events: none;
  }

  /* 05 */
  [data-mock='link'] .stage {
    grid-template-rows: 1fr auto;
    place-items: center;
    padding-bottom: 10px;
  }
  .status {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
  }

  /* 06 */
  .traces {
    width: min(100%, 420px);
    height: auto;
    display: block;
  }
  .traces .wire path {
    stroke: var(--line-hi);
    stroke-width: 1.2;
  }
  .traces .pads circle {
    fill: var(--ink);
    stroke: var(--line-hi);
    stroke-width: 1;
  }
  .traces text {
    font-family: var(--font-mono);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
    fill: var(--text);
  }
  .traces .tilde-svg {
    fill: var(--violet-text);
  }
  .traces [data-part] {
    opacity: 0;
  }
  .traces [data-pkt] {
    fill: var(--cyan);
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
    .traces [data-part] {
      opacity: 1;
    }
  }
</style>
