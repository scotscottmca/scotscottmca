---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import ReleaseStateTile from '../../components/ReleaseStateTile.astro';
import { formatDate } from '../../utils';

export async function getStaticPaths() {
  const releases = await getCollection('releases', ({ data }) => !data.draft);
  const bySlug = new Map<string, CollectionEntry<'releases'>[]>();
  for (const r of releases) {
    const slug = r.id.split('/')[0];
    const list = bySlug.get(slug);
    if (list) list.push(r);
    else bySlug.set(slug, [r]);
  }
  const noted = [...bySlug.entries()].map(([slug, entries]) => ({
    params: { app: slug },
    props: {
      product: entries[0].data.product,
      entries: entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));

  // Apps that ship to npm have no notes here: their versions are read live
  // from the registry, so a publish shows up without a rebuild.
  const projects = await getCollection('projects', ({ data }) => !data.draft && !!data.npmPackage);
  const npm = projects
    .filter((p) => !bySlug.has(p.id))
    .map((p) => ({
      params: { app: p.id },
      props: { product: p.data.title, entries: [], pkg: p.data.npmPackage, projectId: p.id },
    }));

  return [...noted, ...npm];
}

interface Props {
  product: string;
  entries: CollectionEntry<'releases'>[];
  pkg?: string;
  projectId?: string;
}

const { product, entries, pkg, projectId } = Astro.props;
const rendered = await Promise.all(entries.map(async (r) => ({ r, Content: (await render(r)).Content })));
---

<BaseLayout title={`${product} releases`} description={`Release notes for ${product}.`}>
  <Header />
  <main class="page">
    <div class="container">
      <p class="back"><a class="arrow-link" href="/releases"><Icon name="arrow-left" />releases</a></p>
      <header class="page-head">
        <h1 class="page-title">{product}</h1>
        {
          pkg ? (
            <p class="lede">
              Published to npm on every release. The latest five below are read live from the registry.{' '}
              <a class="text-link" href={`/projects/${projectId}/`}>About {product}</a>.
            </p>
          ) : (
            <p class="lede">{entries.length} release{entries.length === 1 ? '' : 's'}, newest first.</p>
          )
        }
      </header>
      {pkg && <ReleaseStateTile pkg={pkg} />}
      {
        rendered.map(({ r, Content }) => (
          <section class="release" aria-labelledby={`v${r.data.version}`}>
            <div class="release-meta">
              <h2 class="num" id={`v${r.data.version}`}>v{r.data.version}</h2>
              <time class="mono muted" datetime={r.data.date.toISOString()}>{formatDate(r.data.date)}</time>
              {r.data.storeUrl && (
                <a class="arrow-link" href={r.data.storeUrl}>
                  store <Icon name="arrow-up-right" />
                </a>
              )}
            </div>
            <div class="prose">
              <Content />
            </div>
          </section>
        ))
      }
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .release {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 32px;
    padding: 40px 0;
    border-top: 1px solid var(--line);
  }
  .release-meta {
    display: grid;
    gap: 6px;
    align-content: start;
    justify-items: start;
  }
  .release-meta h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 700;
    color: var(--cyan);
  }
  @media (max-width: 860px) {
    .release {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }
</style>
