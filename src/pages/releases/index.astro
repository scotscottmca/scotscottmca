---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { formatDate } from '../../utils';

const releases = await getCollection('releases', ({ data }) => !data.draft);

// Group releases by app slug (the first path segment of the entry id, e.g.
// "giftamer" for src/content/releases/giftamer/giftamer-1.0.1.md).
const apps = new Map<
  string,
  { slug: string; product: string; count: number; latest: Date }
>();
for (const r of releases) {
  const slug = r.id.split('/')[0];
  const existing = apps.get(slug);
  if (existing) {
    existing.count += 1;
    if (r.data.date > existing.latest) existing.latest = r.data.date;
  } else {
    apps.set(slug, { slug, product: r.data.product, count: 1, latest: r.data.date });
  }
}
const appList = [...apps.values()].sort(
  (a, b) => b.latest.getTime() - a.latest.getTime()
);
---

<BaseLayout title="Releases" description="Release notes for ScotScottMcA projects.">
  <Header />
  <main>
    <div class="container">
      <div class="statusstrip">
        <span class="led"></span>
        <span class="title">Release log · Releases</span>
        <span class="meta">{appList.length} apps</span>
      </div>
      <ul class="post-list">
        {
          appList.map((a) => (
            <li>
              <a href={`/releases/${a.slug}`}>
                <strong>{a.product}</strong>
              </a>
              <span style="color:var(--dim)">
                {' '}- {a.count} release{a.count === 1 ? '' : 's'}, latest{' '}
                {formatDate(a.latest)}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <Footer />
</BaseLayout>
