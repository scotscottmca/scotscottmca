---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import { ROLE, PROJECTS, SKILLS, CONTACT } from '../data/cv';
import { ICON_PATHS } from '../data/icons';

// This page drops the voice the rest of the site carries: it is read by people
// assessing, and it should cost them as little time as possible.

// Counts come from the collections, so they cannot go stale on the next post.
// Spelled out, because this page reads as prose rather than as instrumentation.
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight',
  'nine', 'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen',
  'seventeen', 'eighteen', 'nineteen', 'twenty'];
const spell = (n: number) => WORDS[n] ?? String(n);

const postCount = spell((await getCollection('posts', ({ data }) => !data.draft)).length);
const projectCount = spell((await getCollection('projects', ({ data }) => !data.draft)).length);
---

<BaseLayout title="CV" description={`Curriculum vitae for ${SITE.author}, ${ROLE.title} at ${ROLE.org}.`}>
  <Header />
  <main>
    <div class="container">
      <article class="cv">
        <header class="cv-head">
          <div class="cv-head-main">
            <h1>{SITE.author}</h1>
            <p class="cv-role">{ROLE.title}, {ROLE.org}</p>
            <p class="cv-place">{ROLE.location}</p>
          </div>
          <button type="button" class="cv-print" data-print>Print / save as PDF</button>
        </header>

        <section class="cv-section" aria-labelledby="cv-experience">
          <h2 id="cv-experience">Experience</h2>

          <div class="cv-role-head">
            <h3>{ROLE.title}</h3>
            <p class="cv-org">{ROLE.org}</p>
            <p class="cv-dates">{ROLE.start} — Present</p>
          </div>

          <p class="cv-role-note">Selected work, {ROLE.listed}.</p>

          <ol class="cv-projects">
            {
              PROJECTS.map((project) => (
                <li class="cv-project">
                  <div class="cv-project-head">
                    <h4>{project.name}</h4>
                    <p class="cv-project-context">
                      {project.context}
                      {project.period && <span> · {project.period}</span>}
                    </p>
                  </div>
                  <p class="cv-project-summary">{project.summary}</p>
                  <ul class="cv-bullets">
                    {project.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                  <ul class="tags">
                    {project.tags.map((tag) => (
                      <li>
                        <span class="tag">{tag}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="cv-section" aria-labelledby="cv-skills">
          <h2 id="cv-skills">Skills</h2>
          <dl class="cv-skills">
            {
              SKILLS.map((skill) => (
                <div class="cv-skill-row">
                  <dt>{skill.group}</dt>
                  <dd>{skill.items.join(' · ')}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="cv-section" aria-labelledby="cv-writing">
          <h2 id="cv-writing">Writing &amp; projects</h2>
          <p>
            {postCount.charAt(0).toUpperCase() + postCount.slice(1)} technical posts on WSUS, ConfigMgr, Intune, PowerShell and
            the Microsoft Graph, and {projectCount} shipped projects including a
            published Edge extension. <a href="/posts">Read the posts</a> or
            <a href="/projects">browse the projects</a>.
          </p>
        </section>

        <section class="cv-section cv-section-contact" aria-labelledby="cv-contact">
          <h2 id="cv-contact">Contact</h2>
          <p class="cv-availability">
            Not currently looking for work. If you want to ask about something on
            this page, LinkedIn is the surest way to reach me.
          </p>
          <ul class="cv-links">
            <li>
              <a href={CONTACT.linkedin} rel="me noopener noreferrer" target="_blank">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={ICON_PATHS.linkedin} />
                </svg>
                LinkedIn
              </a>
            </li>
            <li>
              <a href={CONTACT.github} rel="me noopener noreferrer" target="_blank">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={ICON_PATHS.github} />
                </svg>
                GitHub
              </a>
            </li>
          </ul>
        </section>
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
