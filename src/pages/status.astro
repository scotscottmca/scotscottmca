---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
---

<BaseLayout
  title="Is Scott awake?"
  description={`The live awake/asleep status of ${SITE.author}, read from his watch through the Google Health API and drawn on a 24-hour track.`}
>
  <Header />
  <main class="page">
    <div class="container">
      <!-- Every element here is painted by the live fetch; nothing ships a
           guessed state. The raw response is shown beside the reading. -->
      <section class="reading" data-status-root data-state="loading" data-tone="down" aria-live="polite">
        <p class="prompt"><span class="ps">scott@larkhall:~$</span> curl -s scotscottmca.com/api/status | jq</p>

        <div class="board">
          <div class="stack">
            <div class="panel">
              <div class="panel-bar">
                <span class="bar-left"><span class="lamp" data-tone="down" data-status-led></span>status.live</span>
                <span data-status-meta>asking the watch…</span>
              </div>
              <div class="reading-head">
                <div class="sprite-inset" data-sprite-slot aria-hidden="true"></div>
                <div>
                  <p class="reading-lead">// right now, scott is</p>
                  <h1 class="reading-state" data-status-word>reading…</h1>
                  <p class="reading-line">
                    <b data-status-headline></b>
                    <span data-status-tagline>Give the watch a second.</span>
                  </p>
                </div>
              </div>
            </div>

            <div class="panel track">
              <div class="panel-bar">
                <span>timeline --last 24h</span>
                <span class="track-key" aria-hidden="true">
                  <span class="key key-sleep">sleep</span>
                  <span class="key key-move">activity</span>
                  <span class="key key-now">now</span>
                </span>
              </div>
              <div class="track-body">
                <div class="track-rail" role="img" data-track-rail aria-label="The last 24 hours">
                  <span class="track-block track-sleep" data-track-sleep hidden></span>
                  <span class="track-block track-move" data-track-move hidden></span>
                  <span class="track-cursor" data-track-cursor></span>
                </div>
                <ol class="track-axis" data-track-axis aria-label="Clock times along the track">
                  <li>−24 h</li><li>−18 h</li><li>−12 h</li><li>−6 h</li><li>now</li>
                </ol>
                <p class="track-empty" data-track-empty hidden>No sleep or activity on record in this window.</p>
              </div>
            </div>

            <dl class="facts panel" data-facts hidden></dl>
          </div>

          <div class="panel raw">
            <div class="panel-bar">
              <span>GET /api/status</span>
              <span><span class="http" data-raw-code>…</span> <span data-raw-ms></span></span>
            </div>
            <pre class="raw-body" data-raw>{'{\n  "status": "…"\n}'}</pre>
            <p class="poll" data-poll>polling every 60 s</p>
          </div>
        </div>

        <p class="fineprint">
          <span class="comment">#</span> From my Fitbit sleep and activity data via the
          <a class="text-link" href="https://developers.google.com/health/">Google Health API</a>, through an Azure
          Function. Syncs when my watch does, so I might be a few minutes behind. The track draws my latest sleep and
          current activity only.
          <span data-status-note></span>
        </p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const root = document.querySelector('[data-status-root]');
  const led = root.querySelector('[data-status-led]');
  const meta = root.querySelector('[data-status-meta]');
  const spriteSlot = root.querySelector('[data-sprite-slot]');
  const word = root.querySelector('[data-status-word]');
  const headline = root.querySelector('[data-status-headline]');
  const tagline = root.querySelector('[data-status-tagline]');
  const sleepBlock = root.querySelector('[data-track-sleep]');
  const moveBlock = root.querySelector('[data-track-move]');
  const cursor = root.querySelector('[data-track-cursor]');
  const axis = root.querySelector('[data-track-axis]');
  const trackEmpty = root.querySelector('[data-track-empty]');
  const facts = root.querySelector('[data-facts]');
  const note = root.querySelector('[data-status-note]');

  // The state word is the plain state, as on the home tile. The rotating
  // headline and tagline pair become the line beneath it.
  const STATES = {
    asleep: { word: 'Asleep', sprite: 'scott-asleep', tone: 'rest', period: '4.8s' },
    awake: { word: 'Awake', sprite: 'scott-awake', tone: 'up', period: '2.4s' },
    walking: { word: 'Out walking', sprite: 'scott-walking', tone: 'move', period: '1.4s' },
    'working-out': { word: 'Working out', sprite: 'scott-working-out', tone: 'move', period: '0.9s' },
    active: { word: 'Up and active', sprite: 'scott-active', tone: 'move', period: '1.6s' },
  };

  const AWAKE = {
    headlines: [
      'Awake',
      'Up and about',
      'Very much awake',
      'Online & Operational',
      'Compiled & Running',
      'Up & Paws-itively Awake',
      'Currently In Production',
    ],
    taglines: [
      'Probably fuelled by coffee.',
      'Doing something with endpoints, no doubt.',
      'Eyes open, PowerShell ready.',
      'Fueled by dark roast and dachshund tail wags.',
      'Stepping around sausage dogs, writing C#, avoiding meetings.',
      'Out walking the dachshunds before the stand-up.',
      'Converting hop-infused water into functional code.',
      'Staring at a single missing semicolon since 7:00 AM.',
    ],
  };
  const ASLEEP = {
    headlines: [
      'Asleep',
      'Fast asleep',
      'Off the clock',
      'Offline & Re-indexing',
      'Thread-Locked',
      'Out for the Count',
      'Resting the Low-Riders',
    ],
    taglines: [
      'Do not deploy on a Friday. Or now.',
      'Dreaming of 100% patch compliance.',
      'Back soon. Probably.',
      'In a deep sleep, supervised by two curled-up sausages.',
      'Currently tucked in under a heap of dachshunds.',
      'Dreaming of zero-day vulnerabilities and cold IPA on draft.',
      'System rebooting. Please try again after the first cup of coffee.',
      'Powered down for the night. Do not touch the production database.',
      "Resting up for tomorrow's code review (and dog walk).",
    ],
  };
  const WORKOUT = {
    headlines: [
      'Working out',
      'Mid-Workout',
      'Getting the Reps In',
      'Load-Testing the Muscles',
      'Running a Cardio Job',
      'Lifting Something Heavier Than a Laptop',
      'Deploying Sweat',
    ],
    taglines: [
      'Heart rate up, excuses down.',
      'Compiling gains, one rep at a time.',
      'The only meeting right now is me vs the dumbbells.',
      'Zone 2 cardio, zero Slack notifications.',
      'Burning calories like unoptimised loops.',
      'Training so the dachshunds have to keep up.',
      'Sweating now so the deploy goes smoothly later.',
    ],
  };
  const WALKING = {
    headlines: [
      'Out walking',
      'On the Move',
      'Walking the Low-Riders',
      'Clocking Up Steps',
      'Taking the Sausages Out',
      'Stretching the Legs',
      'On a Hot Girl Walk',
    ],
    taglines: [
      'Two dachshunds, one very slow pace.',
      'Fresh air, podcast on, phone in pocket.',
      'Solving architecture problems one lap of the block at a time.',
      'The dogs set the route, I just follow.',
      'Steps go up, stress goes down.',
      'Rubber-ducking a bug to the dachshunds.',
      'Away from the keyboard, closer to the coffee shop.',
    ],
  };
  const ACTIVE = {
    headlines: [
      'Up and active',
      'On the Go',
      'Heart Rate Climbing',
      'Doing Something Energetic',
      'Warmed Up & Running',
      'Extra-Curricular Activities',
      'Not Sitting Still',
    ],
    taglines: [
      'Moving about - the watch noticed.',
      'Pulse says busy, calendar says who knows.',
      'Off my chair and up to something.',
      'Somewhere between the desk and the fridge, at speed.',
      'Elevated heart rate, elevated mood.',
      'Chasing a dachshund, probably.',
      'Active now, back at the keyboard soon.',
    ],
  };
  const COPY = { awake: AWAKE, asleep: ASLEEP, 'working-out': WORKOUT, walking: WALKING, active: ACTIVE };

  const HOUR = 3600000;
  const WINDOW = 24 * HOUR;
  const pick = (arr) => arr[Math.floor(Math.random() * arr.length)];
  const clock = (d) => d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

  function humanize(mins) {
    if (mins == null || mins < 1) return 'just now';
    const h = Math.floor(mins / 60);
    const m = mins % 60;
    if (h === 0) return `${m} min`;
    if (m === 0) return `${h} hr`;
    return `${h} hr ${m} min`;
  }

  function setFacts(entries) {
    facts.innerHTML = '';
    if (!entries.length) {
      facts.hidden = true;
      return;
    }
    for (const [label, value] of entries) {
      const wrap = document.createElement('div');
      const dt = document.createElement('dt');
      dt.textContent = label;
      const dd = document.createElement('dd');
      dd.textContent = value;
      wrap.append(dt, dd);
      facts.append(wrap);
    }
    facts.hidden = false;
  }

  // Place a block on the track. Times are ms; the window ends at `now`.
  function placeBlock(el, start, end, label, now) {
    const from = now - WINDOW;
    const a = Math.max(from, start);
    const b = Math.min(now, end);
    if (!(b > a)) {
      el.hidden = true;
      return false;
    }
    const left = ((a - from) / WINDOW) * 100;
    const width = Math.max(((b - a) / WINDOW) * 100, 0.6);
    el.style.left = `${left}%`;
    el.style.width = `${width}%`;
    el.textContent = label;
    el.hidden = false;
    fit(el);
    return true;
  }

  // A label that does not fit its block is hidden rather than clipped.
  function fit(el) {
    el.dataset.narrow = 'false';
    if (el.scrollWidth > el.clientWidth + 1) el.dataset.narrow = 'true';
  }
  let fitTimer = null;
  window.addEventListener('resize', () => {
    clearTimeout(fitTimer);
    fitTimer = setTimeout(() => [sleepBlock, moveBlock].forEach((b) => !b.hidden && fit(b)), 120);
  });

  function paintTrack(data, status, now) {
    const stamps = [];
    for (let i = 4; i >= 1; i--) stamps.push(clock(new Date(now - i * 6 * HOUR)));
    stamps.push('now');
    axis.innerHTML = stamps.map((s) => `<li>${s}</li>`).join('');

    let drawn = 0;
    if (data.lastSleep && data.lastSleep.start && data.lastSleep.end) {
      const s = Date.parse(data.lastSleep.start);
      const e = status === 'asleep' ? now : Date.parse(data.lastSleep.end);
      if (placeBlock(sleepBlock, s, e, `Sleep ${humanize(Math.round((e - s) / 60000))}`, now)) drawn++;
    } else {
      sleepBlock.hidden = true;
    }

    let move = null;
    const session = status === 'walking' ? data.walk : status === 'working-out' ? data.workout : null;
    if (session && session.durationMin != null) {
      const end = now - (session.endedMinAgo || 0) * 60000;
      move = [end - session.durationMin * 60000, end, `${session.name || 'Activity'} ${humanize(session.durationMin)}`];
    } else if (status === 'walking' && data.steps && data.steps.recent != null) {
      move = [now - data.steps.windowMin * 60000, now, `${data.steps.recent} steps`];
    } else if (status === 'active' && data.heartRate && data.heartRate.bpm != null) {
      const at = now - (data.heartRate.atMinAgo || 0) * 60000;
      move = [at - 5 * 60000, at + 5 * 60000, `${data.heartRate.bpm} bpm`];
    }
    if (move && placeBlock(moveBlock, move[0], move[1], move[2], now)) drawn++;
    else moveBlock.hidden = true;

    trackEmpty.hidden = drawn > 0;
  }

  function paintSprite(state) {
    if (!state) {
      spriteSlot.replaceChildren();
      return;
    }
    let img = spriteSlot.firstElementChild;
    if (!img) {
      img = document.createElement('img');
      img.className = 'sprite';
      img.width = 240;
      img.height = 240;
      img.alt = '';
      spriteSlot.appendChild(img);
    }
    img.src = `/images/status/${state.sprite}.svg`;
  }

  // The header lamp reports whatever this reading found.
  function announce(ok) {
    const fleet = document.querySelector('[data-fleet-led]');
    if (fleet) fleet.dataset.tone = ok ? 'ok' : 'down';
  }

  function render(data) {
    const status = data.status || 'unknown';
    const state = STATES[status];
    const now = data.updated ? Date.parse(data.updated) : Date.now();

    if (!state) {
      root.dataset.state = 'unknown';
      root.dataset.tone = 'down';
      led.dataset.tone = 'down';
      cursor.dataset.tone = 'down';
      word.textContent = 'No signal';
      headline.textContent = '';
      tagline.textContent = data.note || 'Could not reach the status service. Retrying.';
      meta.textContent = 'service unreachable';
      paintSprite(null);
      sleepBlock.hidden = true;
      moveBlock.hidden = true;
      trackEmpty.hidden = true;
      setFacts([]);
      note.textContent = '';
      announce(false);
      return;
    }

    const copy = COPY[status];
    root.dataset.state = status;
    root.dataset.tone = state.tone;
    led.dataset.tone = state.tone;
    cursor.dataset.tone = state.tone;
    root.style.setProperty('--led-period', state.period);
    word.textContent = state.word;
    headline.textContent = `${pick(copy.headlines)}.`;
    tagline.textContent = pick(copy.taglines);
    paintSprite(state);
    paintTrack(data, status, now);

    const entries = [];
    if (status === 'asleep' && data.asleepForMin != null) entries.push(['Asleep for', humanize(data.asleepForMin)]);
    if (status === 'asleep' && data.lastSleep && data.lastSleep.start) {
      entries.push(['Went down', clock(new Date(data.lastSleep.start))]);
    }
    if (status === 'awake' && data.awakeForMin != null) entries.push(['Awake for', humanize(data.awakeForMin)]);
    if (status === 'awake' && data.lastSleep && data.lastSleep.end) {
      entries.push(['Woke at', clock(new Date(data.lastSleep.end))]);
    }
    if (status === 'working-out' && data.workout) {
      if (data.workout.name) entries.push(['Activity', data.workout.name]);
      if (data.workout.durationMin != null) entries.push(['Duration', humanize(data.workout.durationMin)]);
    }
    if (status === 'walking' && data.walk) {
      if (data.walk.name) entries.push(['Activity', data.walk.name]);
      if (data.walk.durationMin != null) entries.push(['Duration', humanize(data.walk.durationMin)]);
      if (data.walk.steps != null) entries.push(['Steps', String(data.walk.steps)]);
    } else if (status === 'walking' && data.steps && data.steps.recent != null) {
      entries.push([`Steps (last ${data.steps.windowMin} min)`, String(data.steps.recent)]);
    }
    if (status === 'active' && data.heartRate && data.heartRate.bpm != null) {
      entries.push(['Heart rate', `${data.heartRate.bpm} bpm`]);
    }
    if (status !== 'asleep' && data.lastSleep && data.lastSleep.durationMin != null) {
      entries.push(['Last sleep', humanize(data.lastSleep.durationMin)]);
    }
    setFacts(entries);

    const degraded = data.source === 'mock' || data.source === 'fallback' || data.source === 'cache-stale';
    const conf = data.confidence ? `${data.confidence} confidence · ` : '';
    meta.textContent = `${conf}synced ${clock(new Date(now))}`;
    note.textContent = degraded ? data.note || 'Showing a demo status.' : '';
    announce(!degraded);
  }

  let retryTimer = null;

  // The raw response, pretty-printed and lightly highlighted. Escaped first,
  // so nothing in the payload is ever read as markup.
  const raw = root.querySelector('[data-raw]');
  const rawCode = root.querySelector('[data-raw-code]');
  const rawMs = root.querySelector('[data-raw-ms]');
  const poll = root.querySelector('[data-poll]');
  let lastPoll = Date.now();
  function showRaw(code, ms, body) {
    const esc = JSON.stringify(body, null, 2).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    raw.innerHTML = esc
      .replace(/("(?:[^"\\]|\\.)*")(\s*:)/g, '<span class="k">$1</span>$2')
      .replace(/:\s("(?:[^"\\]|\\.)*")/g, ': <span class="s">$1</span>')
      .replace(/:\s(-?\d+(?:\.\d+)?|true|false|null)/g, ': <span class="n">$1</span>');
    rawCode.textContent = code ? `${code} OK` : 'ERR';
    rawCode.dataset.ok = code ? 'true' : 'false';
    rawMs.textContent = `${Math.round(ms)} ms`;
  }
  setInterval(() => {
    const left = Math.max(0, 60 - Math.round((Date.now() - lastPoll) / 1000));
    poll.textContent = `polling every 60 s · next in ${left} s`;
  }, 1000);

  async function refresh() {
    if (retryTimer) {
      clearTimeout(retryTimer);
      retryTimer = null;
    }
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 9000);
    const t0 = performance.now();
    lastPoll = Date.now();
    try {
      const resp = await fetch('/api/status', {
        headers: { Accept: 'application/json' },
        signal: controller.signal,
      });
      if (!resp.ok) throw new Error(String(resp.status));
      const data = await resp.json();
      showRaw(resp.status, performance.now() - t0, data);
      render(data);
    } catch (err) {
      showRaw(null, performance.now() - t0, { error: String(err && err.message ? err.message : err) });
      render({ status: 'unknown', source: 'fallback', note: 'Could not reach my status service. Retrying...' });
      // Cold start or a slow upstream: try again soon rather than waiting a full minute.
      retryTimer = setTimeout(refresh, 8000);
    } finally {
      clearTimeout(timeout);
    }
  }

  refresh();
  setInterval(refresh, 60000);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') refresh();
  });
</script>

<style>
  /* Nerd mode: everything in mono, every value from the wire. */
  .reading {
    --led-period: 2.4s;
    --tone: var(--cyan);
    font-family: var(--font-mono);
  }
  .reading[data-tone='rest'] {
    --tone: var(--violet-text);
  }
  .reading[data-tone='down'] {
    --tone: var(--faint);
  }
  .reading :global([hidden]) {
    display: none !important;
  }
  .prompt {
    margin: 0 0 24px;
    font-size: 14px;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .ps {
    color: var(--violet-text);
  }
  .board {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 16px;
    align-items: start;
  }
  .stack {
    display: grid;
    gap: 16px;
    min-width: 0;
  }
  .bar-left {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
  }
  .panel-bar [data-status-meta] {
    font-variant-numeric: tabular-nums;
  }
  .lamp {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tone);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--tone) 20%, transparent);
    animation: blink var(--led-period) steps(2) infinite;
  }
  .lamp[data-tone='down'] {
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--faint);
    animation: none;
  }
  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }

  .reading-head {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    padding: 24px;
  }
  .sprite-inset {
    aspect-ratio: 1;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 12.5%,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 12.5% 100%,
      var(--ink);
  }
  .sprite-inset:empty::after {
    content: 'NO_DATA';
    font-size: 12px;
    color: var(--faint);
  }
  .sprite-inset :global(.sprite) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    image-rendering: pixelated;
  }
  .reading-lead {
    margin: 0 0 4px;
    font-size: 13px;
    color: var(--faint);
  }
  .reading-state {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--tone);
    text-wrap: balance;
    transition: color 300ms ease;
  }
  [data-tone='down'] .reading-state {
    font-size: 28px;
    color: var(--muted);
  }
  .reading-line {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 48ch;
  }
  .reading-line b {
    color: var(--text);
    font-weight: 650;
  }

  .track {
    transition: opacity 300ms ease;
  }
  [data-state='loading'] .track,
  [data-state='unknown'] .track {
    opacity: 0.5;
  }
  .track-body {
    display: grid;
    gap: 10px;
    padding: 20px;
  }
  .track-key {
    display: flex;
    gap: 16px;
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .key::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }
  .key-sleep::before {
    background: var(--violet);
  }
  .key-move::before {
    background: var(--cyan);
  }
  .key-now::before {
    width: 2px;
    height: 12px;
    background: var(--text);
  }
  .track-rail {
    position: relative;
    height: 72px;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    background:
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 100% / calc(100% / 24) 30% repeat-x,
      linear-gradient(90deg, var(--line-hi) 1px, transparent 1px) 0 0 / 25% 100% repeat-x,
      var(--ink);
  }
  .track-block {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    padding: 0 8px;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    font-variant-numeric: tabular-nums;
  }
  .track-block[data-narrow='true'] {
    color: transparent;
    padding: 0;
  }
  .track-sleep {
    background: color-mix(in srgb, var(--violet) 55%, transparent);
    border-inline: 1px solid var(--violet-text);
    color: #fff;
  }
  .track-move {
    background: color-mix(in srgb, var(--cyan) 22%, transparent);
    border-inline: 1px solid var(--cyan);
    color: var(--cyan);
  }
  .track-cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 2px;
    background: var(--tone);
    box-shadow: 0 0 12px var(--tone);
    animation: blink var(--led-period) steps(2) infinite;
  }
  .track-cursor[data-tone='down'] {
    box-shadow: none;
    animation: none;
  }
  .track-axis {
    list-style: none;
    margin: 0;
    padding: 0;
