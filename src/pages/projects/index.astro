---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';

function rank(p: { data: { featured: boolean; date?: Date } }) {
  return (p.data.featured ? 1e13 : 0) + (p.data.date ? p.data.date.getTime() : 0);
}

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => rank(b) - rank(a)
);
---

<BaseLayout title="Projects" description="Projects I'm working on or have worked on.">
  <Header />
  <main>
    <div class="container">
      <div class="statusstrip">
        <span class="led"></span>
        <span class="title">Payload manifest · Projects</span>
        <span class="meta">{projects.length} deployed</span>
      </div>
      {
        projects.length === 0 ? (
          <p style="color:var(--dim);margin-top:1rem">Nothing here yet — check back soon.</p>
        ) : (
          <ul class="project-grid">
            {projects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </ul>
        )
      }
    </div>
  </main>
  <Footer />
</BaseLayout>
