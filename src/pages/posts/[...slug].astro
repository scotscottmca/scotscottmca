---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../config';
import { excerpt, formatDate, readingTime } from '../../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  newer?: CollectionEntry<'posts'>;
  older?: CollectionEntry<'posts'>;
}

const { post, newer, older } = Astro.props;
const { title, date, lastModified, author, tags, image = SITE.ogImage } = post.data;
const { Content } = await render(post);
const mins = readingTime(post.body);
const description = post.data.description ?? excerpt(post.body);

const jsonLd = {
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (lastModified ?? date).toISOString(),
  author: { '@type': 'Person', name: author, url: SITE.url },
  image: new URL(image, SITE.url).toString(),
  keywords: tags.join(', '),
  mainEntityOfPage: new URL(Astro.url.pathname, SITE.url).toString(),
};
---

<BaseLayout title={title} description={description} image={image} article={true} jsonLd={jsonLd}>
  <Header />
  <main class="page">
    <div class="container">
      <p class="back"><a class="arrow-link" href="/posts"><Icon name="arrow-left" />writing</a></p>
      <article>
        <header class="article-head">
          <h1>{title}</h1>
          <p class="lede">{description}</p>
          <div class="article-meta">
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
            <span>{mins} min read</span>
            {
              lastModified && lastModified.getTime() !== date.getTime() && (
                <span>
                  updated <time datetime={lastModified.toISOString()}>{formatDate(lastModified)}</time>
                </span>
              )
            }
          </div>
          {
            tags.length > 0 && (
              <ul class="tags">
                {tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            )
          }
        </header>
        <div class="prose">
          <Content />
        </div>
      </article>

      <div class="signoff">
        <img src="/images/emotes/crt-monitor.png" alt="Pixel-art Scott holding an old CRT monitor overhead" width="56" height="56" />
        <span>EOF — thanks for reading.</span>
      </div>

      <nav class="pager" aria-label="More posts">
        {
          older ? (
            <a class="pager-link panel" href={`/posts/${older.id}/`}>
              <span class="arrow-link"><Icon name="arrow-left" />older</span>
              <span class="pager-title">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <a class="pager-link pager-newer panel" href={`/posts/${newer.id}/`}>
              <span class="arrow-link">newer<Icon name="arrow-right" /></span>
              <span class="pager-title">{newer.data.title}</span>
            </a>
          )
        }
      </nav>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 32px;
  }
  .pager-link {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px;
    transition: border-color 180ms var(--ease);
  }
  .pager-link:hover {
    border-color: var(--cyan);
  }
  .pager-newer {
    text-align: right;
    justify-items: end;
  }
  .pager-title {
    font-weight: 650;
    line-height: 1.35;
    text-wrap: balance;
  }
  @media (max-width: 720px) {
    .pager {
      grid-template-columns: minmax(0, 1fr);
    }
    .pager-newer {
      text-align: left;
      justify-items: start;
    }
  }
</style>
