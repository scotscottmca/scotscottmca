---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../config';
import { excerpt, formatDate, readingTime } from '../../utils';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, lastModified, author, tags, image = SITE.ogImage } = post.data;
const { Content } = await render(post);
const mins = readingTime(post.body);
const description = post.data.description ?? excerpt(post.body);

const jsonLd = {
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (lastModified ?? date).toISOString(),
  author: { '@type': 'Person', name: author, url: SITE.url },
  image: new URL(image, SITE.url).toString(),
  keywords: tags.join(', '),
  mainEntityOfPage: new URL(Astro.url.pathname, SITE.url).toString(),
};
---

<BaseLayout title={title} description={description} image={image} article={true} jsonLd={jsonLd}>
  <Header />
  <main>
    <div class="container">
      <article>
        <header class="article-header">
          <h1>{title}</h1>
          <div class="post-meta">
            <span>{author}</span>
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
            <span>{mins} min read</span>
            {
              lastModified && lastModified.getTime() !== date.getTime() && (
                <span>Updated {formatDate(lastModified)}</span>
              )
            }
          </div>
          {
            tags.length > 0 && (
              <ul class="tags" style="margin-top:0.75rem">
                {tags.map((t) => (
                  <li>
                    <span class="tag">{t}</span>
                  </li>
                ))}
              </ul>
            )
          }
        </header>
        <div class="prose">
          <Content />
        </div>
      </article>
      <hr />

      <div class="emote-panel" style="margin-bottom:1.5rem">
        <img
          src="/images/emotes/crt-monitor.png"
          alt="Illustration of Scott holding an old CRT monitor overhead"
          width="60"
          height="60"
        />
        <span class="emote-caption">Transmission ended</span>
      </div>

      <p><a href="/posts">← All posts</a></p>
    </div>
  </main>
  <Footer />
</BaseLayout>
