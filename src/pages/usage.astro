---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

// Unlisted: no nav link, noindex, out of the sitemap. Reads the JSON that
// scripts/usage-stats.mjs publishes every 15 minutes. That JSON carries three
// windows — 7 days, 14 days, the billing cycle so far — so the switcher below
// only re-renders; it never refetches.
---

<BaseLayout title="Usage" description="How much Claude and GitHub Scott has been using lately." noindex>
  <Header />
  <main>
    <div class="container container-wide usage" data-usage data-tone="reading">
      <section class="figures">
        <h2 class="ledger-heading figures-heading">
          <span class="led" data-led data-tone="down"></span>
          <span data-window>Live · last 7 days</span>
          <span class="tile-meta" data-updated>Reading…</span>
        </h2>
        <div class="ranges" data-ranges role="group" aria-label="Window">
          <button type="button" class="range" data-range="7d" aria-pressed="true">7 days</button>
          <button type="button" class="range" data-range="14d" aria-pressed="false">14 days</button>
          <button type="button" class="range" data-range="cycle" aria-pressed="false">Billing cycle</button>
        </div>
        <dl class="figure-grid">
          <div class="figure"><dd class="figure-value figure-live" data-f="live">–</dd><dt class="figure-unit">Live now</dt></div>
          <div class="figure"><dd class="figure-value" data-f="sessions">–</dd><dt class="figure-unit">Sessions</dt></div>
          <div class="figure"><dd class="figure-value" data-f="merged">–</dd><dt class="figure-unit">PRs merged</dt></div>
          <div class="figure"><dd class="figure-value" data-f="tokens">–</dd><dt class="figure-unit">Tokens</dt></div>
          <div class="figure"><dd class="figure-value" data-f="spend">–</dd><dt class="figure-unit">Spend</dt></div>
          <div class="figure"><dd class="figure-value" data-f="messages">–</dd><dt class="figure-unit">Turns</dt></div>
          <div class="figure"><dd class="figure-value" data-f="hours">–</dd><dt class="figure-unit">Hours</dt></div>
          <div class="figure"><dd class="figure-value" data-f="commits">–</dd><dt class="figure-unit">Commits</dt></div>
          <div class="figure"><dd class="figure-value" data-f="open">–</dd><dt class="figure-unit">PRs open</dt></div>
        </dl>
      </section>

      <section class="panel" data-days hidden>
        <h2 class="ledger-heading">Tokens per day</h2>
        <ol class="bars" data-bars></ol>
      </section>

      <section class="panel" data-models hidden>
        <h2 class="ledger-heading">By model</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Model</th><th>Turns</th><th>Output</th><th>Cache read</th><th>Cost</th></tr></thead>
            <tbody data-model-rows></tbody>
          </table>
        </div>
      </section>

      <section class="panel" data-merged hidden>
        <h2 class="ledger-heading">Merged</h2>
        <ol class="merged" data-merged-rows></ol>
      </section>

      <p class="fineprint">
        Claude figures come from the Claude Code transcripts on each machine I work on, added together, so they cover only what ran locally.
        Spend is the API list price for those tokens; I'm on a subscription, so it's what it <em>would</em> cost.
        The billing cycle runs from the renewal day of the month to today.
        GitHub figures are PRs and commits authored by me, across every repo. Republished every 15 minutes while a Mac is awake.
      </p>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { SITE } from '../config';

  const root = document.querySelector('[data-usage]') as HTMLElement;
  const q = (sel: string) => root.querySelector(sel) as HTMLElement;

  const compact = (n: number) => Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 }).format(n);
  const money = (n: number) => `$${n >= 100 ? Math.round(n) : n.toFixed(n >= 10 ? 0 : 2)}`;
  const ago = (iso: string) => {
    const m = Math.round((Date.now() - Date.parse(iso)) / 60000);
    return m < 1 ? 'just now' : m < 60 ? `${m} min ago` : `${Math.round(m / 60)} h ago`;
  };
  const utc = (d: string) => new Date(d + 'T00:00:00Z');
  const dayLabel = (d: string) => utc(d).toLocaleDateString('en-GB', { weekday: 'short', timeZone: 'UTC' });
  const dmy = (d: string) => utc(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });

  let latest: any = null;
  let range = '7d';

  // A feed from a device still on the single-window format has no `windows`;
  // read it as the 7-day one it is rather than showing nothing.
  const windowsOf = (data: any) =>
    data.windows ?? { '7d': { label: 'Last 7 days', days: data.windowDays ?? 7, claude: data.claude, github: data.github } };

  function paint() {
    const data = latest;
    if (!data) return;
    const windows = windowsOf(data);
    const w = windows[range] ?? windows['7d'];
    const c = w.claude, g = w.github;
    const n = w.days ?? 7;
    const live = data.live ?? data.claude?.live ?? [];

    root.dataset.tone = 'up';
    q('[data-updated]').textContent = `Updated ${ago(data.updated)}`;
    q('[data-window]').textContent =
      `Live · ${range === 'cycle' && w.since ? `billing cycle since ${dmy(w.since)}` : String(w.label ?? '').toLowerCase()}`;

    q('[data-led]').dataset.tone = live.length ? 'up' : 'idle';
    for (const b of root.querySelectorAll('[data-ranges] button')) {
      const key = (b as HTMLElement).dataset.range!;
      b.setAttribute('aria-pressed', String(key === range));
      (b as HTMLElement).hidden = !windows[key];
    }

    const f: Record<string, string | number> = {
      live: live.length,
      sessions: c.sessions,
      merged: g.mergedCount,
      tokens: compact(c.totals.input + c.totals.output + c.totals.cacheWrite + c.totals.cacheRead),
      spend: money(c.totals.cost),
      messages: compact(c.totals.messages),
      hours: Math.round(c.hoursActive),
      commits: g.commits,
      open: data.github?.openPrs ?? g.openPrs,
    };
    for (const [k, v] of Object.entries(f)) q(`[data-f="${k}"]`).textContent = String(v);

    // One bar per day of the window, oldest first, empty days included. Past a
    // fortnight the labels thin out to every fifth day, plus the two ends, so
    // they stay readable.
    const days: string[] = [];
    for (let i = n - 1; i >= 0; i--) days.push(new Date(Date.now() - i * 86400000).toISOString().slice(0, 10));
    const max = Math.max(1, ...days.map((d) => c.days[d]?.tokens ?? 0));
    const bars = q('[data-bars]');
    bars.style.setProperty('--cols', String(n));
    bars.toggleAttribute('data-dense', n > 7);
    bars.replaceChildren(
      ...days.map((d, i) => {
        const v = c.days[d];
        const date = utc(d).getUTCDate();
        const ends = i === 0 || i === days.length - 1;
        const label = n <= 7 ? dayLabel(d) : n <= 14 || date % 5 === 0 || ends ? String(date) : '';
        const li = document.createElement('li');
        li.title = v ? `${d}: ${compact(v.tokens)} tokens, ${money(v.cost)}, ${v.sessions} session${v.sessions === 1 ? '' : 's'}` : `${d}: nothing`;
        li.innerHTML = `<span class="bar" style="--h:${v ? Math.max(2, (100 * v.tokens) / max) : 0}%"></span><span class="bar-value">${v && n <= 14 ? compact(v.tokens) : ''}</span><span class="bar-label">${label}</span>`;
        return li;
      })
    );
    q('[data-days]').hidden = false;

    const models = Object.entries(c.models).sort((a: any, b: any) => b[1].cost - a[1].cost);
    q('[data-model-rows]').replaceChildren(
      ...models.map(([name, m]: any) => {
        const tr = document.createElement('tr');
        for (const cell of [name, m.messages, compact(m.output), compact(m.cacheRead), money(m.cost)]) {
          const td = document.createElement('td');
          td.textContent = String(cell);
          tr.append(td);
        }
        return tr;
      })
    );
    q('[data-models]').hidden = models.length === 0;

    q('[data-merged-rows]').replaceChildren(
      ...g.merged.map((p: any) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = p.url; a.textContent = p.title; a.rel = 'noopener';
        const meta = document.createElement('span');
        meta.className = 'merged-meta';
        meta.textContent = `${p.repo} #${p.number} · ${new Date(p.mergedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}`;
        li.append(a, meta);
        return li;
      })
    );
    q('[data-merged]').hidden = g.merged.length === 0;
  }

  q('[data-ranges]').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    range = b.dataset.range!;
    paint();
  });

  // Failure is a state: say the feed is down, never guess a number.
  function fail() {
    root.dataset.tone = 'down';
    q('[data-led]').dataset.tone = 'down';
    q('[data-updated]').textContent = 'No signal from the usage feed';
  }

  async function refresh() {
    try {
      const r = await fetch(SITE.usageDataUrl, { cache: 'no-cache' });
      if (!r.ok) throw new Error(String(r.status));
      latest = await r.json();
      paint();
    } catch {
      fail();
    }
  }
  refresh();
  setInterval(refresh, 5 * 60000);
  document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && refresh());
</script>

<!-- Global, namespaced under .usage: the rows and bars are built at runtime and
     would miss Astro's scoped-style attribute. -->
<style is:global>
  .usage {
    display: grid;
    gap: 1.6rem;
    margin: 1rem auto 3rem;
  }
  /* Grid children otherwise keep their content's min width and push the
     table past a phone's viewport. */
  .usage > * { min-width: 0; }
  .usage .panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem 1.35rem;
  }
  .usage .led[data-tone='idle'] { background: var(--amber); box-shadow: 0 0 6px var(--amber); }
  /* Unboxed, but inset to the panels' own content edge so the columns line up. */
  .usage .figures { padding: 0 1.35rem; }
  .usage .figures-heading { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }

  /* Window switcher: the pressed one wears the amber. */
  .usage .ranges { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.9rem; }
  .usage .range {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--dim);
    cursor: pointer;
    transition: var(--transition);
  }
  .usage .range:hover { color: var(--text); border-color: var(--amber); }
  .usage .range[aria-pressed='true'] { border-color: var(--amber); color: var(--amber); }

  /* One row of nine on a desktop; three per row on a phone. */
  .usage .figure-grid {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: 1.4rem 1rem;
    margin: 1.1rem 0 0;
  }
  .usage .figure dd { margin: 0; }
  .usage .figure-live { color: var(--green); }
  @media (max-width: 960px) {
    .usage .figure-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* One thin amber bar per day of the window; the day label sits under each. */
  .usage .bars {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(var(--cols, 7), minmax(0, 1fr));
    gap: 0.6rem;
    height: 11rem;
    margin: 1.1rem 0 0;
    padding: 0;
  }
  .usage .bars[data-dense] { gap: 0.3rem; }
  .usage .bars li {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    text-align: center;
    font-size: 0.72rem;
    color: var(--dim);
  }
  .usage .bars[data-dense] li { font-size: 0.62rem; }
  .usage .bar-value {
    order: -1;
    font-variant-numeric: tabular-nums;
    align-self: end;
    padding-bottom: 0.3rem;
  }
  .usage .bar {
    display: block;
    align-self: end;
    height: var(--h);
    width: min(100%, 2.4rem);
    justify-self: center;
    background: var(--amber);
    border-radius: 4px 4px 0 0;
  }
  .usage .bar-label {
    font-family: var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-top: 0.4rem;
    border-top: 1px solid var(--line);
    min-height: 1.2em;
  }

  .usage .table-wrap { overflow-x: auto; margin-top: 0.6rem; }
  .usage table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .usage th, .usage td { text-align: right; padding: 0.55rem 0.6rem; border-bottom: 1px solid var(--line); font-variant-numeric: tabular-nums; }
  .usage th:first-child, .usage td:first-child { text-align: left; }
  .usage th { font-family: var(--font-display); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--dim); font-weight: 400; }
  .usage tr:last-child td { border-bottom: 0; }

  .usage .merged { list-style: none; margin: 0.6rem 0 0; padding: 0; }
  .usage .merged li { display: grid; gap: 0.2rem; padding: 0.7rem 0; border-bottom: 1px solid var(--line); font-size: 0.88rem; }
  .usage .merged li:last-child { border-bottom: 0; }
  .usage .merged-meta { color: var(--dim); font-size: 0.78rem; font-variant-numeric: tabular-nums; }

  .usage .fineprint { margin: 0; font-size: 0.78rem; line-height: 1.6; color: var(--dim); }

  @media (max-width: 640px) {
    .usage .bars { gap: 0.35rem; height: 9rem; }
    .usage .bar-value { font-size: 0.62rem; }
    /* Fourteen columns of numbers do not fit a phone; the tooltips still do.
       Hidden, not removed: the bar's height is a percentage of the row below
       this one, and dropping a row would leave it nothing to measure. */
    .usage .bars[data-dense] .bar-value { visibility: hidden; }
  }
</style>
