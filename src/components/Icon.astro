---
// Lucide Animated icons (https://lucide-animated.com, MIT), drawn as plain SVG.
// The library ships React + Motion components; this site has neither, so each
// icon keeps its Lucide paths, split into the parts its animation moves, and
// the motion itself lives in global.css under "Animated icons". An icon plays
// when the link or button around it is hovered or focused.

const ICONS = {
  'arrow-right': `<path class="shaft" d="M5 12h14"/><path class="head" d="m12 5 7 7-7 7"/>`,
  'arrow-left': `<path class="shaft" d="M19 12H5"/><path class="head" d="m12 19-7-7 7-7"/>`,
  'arrow-up-right': `<g class="g"><path d="M7 7H17"/><path d="M17 7V17"/><path d="M7 17L17 7"/></g>`,
  'chevron-down': `<path class="g" d="m6 9 6 6 6-6"/>`,
  coffee: `<path class="steam" style="--d:1" d="M10 2v2"/><path class="steam" style="--d:2" d="M14 2v2"/><path class="steam" style="--d:0" d="M6 2v2"/><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"/>`,
  download: `<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><g class="g"><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></g>`,
  'file-text': `<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path class="line" pathLength="1" style="--d:0" d="M10 9H8"/><path class="line" pathLength="1" style="--d:1" d="M16 13H8"/><path class="line" pathLength="1" style="--d:2" d="M16 17H8"/>`,
  'folder-code': `<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2z"/><path class="l" d="M10 10.5 8 13l2 2.5"/><path class="r" d="m14 10.5 2 2.5-2 2.5"/>`,
  github: `<path class="body" pathLength="1" d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path class="tail" pathLength="1" d="M9 18c-4.51 2-5-2-7-2"/>`,
  'heart-pulse': `<path class="heart" d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/><path class="draw" pathLength="1" style="--d:2" d="M3.22 13H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>`,
  'id-card': `<path class="draw" pathLength="1" style="--d:2" d="M16 10h2"/><path class="draw" pathLength="1" style="--d:2" d="M16 14h2"/><path class="draw" pathLength="1" d="M6.17 15a3 3 0 0 1 5.66 0"/><circle class="draw" pathLength="1" style="--d:1" cx="9" cy="11" r="2"/><rect width="20" height="14" x="2" y="5" rx="2"/>`,
  linkedin: `<path class="draw" pathLength="1" d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect class="draw" pathLength="1" width="4" height="12" x="2" y="9"/><circle class="draw" pathLength="1" cx="4" cy="4" r="2"/>`,
  'map-pin': `<g class="g"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle class="dot" pathLength="1" cx="12" cy="10" r="3"/></g>`,
  'message-circle': `<path class="g" d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>`,
  rocket: `<g class="g"><path class="fire" d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></g>`,
  terminal: `<path d="m4 17 6-6-6-6"/><path class="cursor" d="M12 19h8"/>`,
  twitter: `<path class="draw" pathLength="1" d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>`,
};

interface Props {
  name: keyof typeof ICONS;
  class?: string;
  label?: string;
}

const { name, class: className, label } = Astro.props;
---

<svg
  class:list={['i', `i-${name}`, className]}
  viewBox="0 0 24 24"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={ICONS[name]}
/>
