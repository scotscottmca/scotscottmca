---
import { SOCIAL } from '../config';
import Icon from './Icon.astro';
---

<ul class="social">
  {
    SOCIAL.map((s) => (
      <li>
        <a href={s.url} target="_blank" rel="me noopener noreferrer" aria-label={s.name} title={s.name}>
          <Icon name={s.icon} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 4px;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    color: var(--muted);
    transition:
      color 180ms var(--ease),
      background 180ms var(--ease);
  }
  .social a:hover {
    color: var(--cyan);
    background: color-mix(in srgb, var(--navy) 70%, transparent);
  }
  .social :global(.i) {
    width: 20px;
    height: 20px;
  }
</style>
