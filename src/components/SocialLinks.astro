---
import { SOCIAL } from '../config';

import { ICON_PATHS as icons } from '../data/icons';
---

<div class="social">
  {
    SOCIAL.map((s) => (
      <a href={s.url} target="_blank" rel="noopener noreferrer" title={s.name} aria-label={s.name}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={icons[s.icon]} />
        </svg>
      </a>
    ))
  }
</div>
