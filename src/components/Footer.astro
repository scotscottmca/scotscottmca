---
import { SITE } from '../config';
const year = new Date().getFullYear();
const range = year > SITE.since ? `${SITE.since}–${year}` : `${SITE.since}`;
---

<footer class="site-footer">
  <div class="container">
    <span>
      <img
        class="site-mascot"
        src="/images/emotes/self.png"
        alt="Scott's pixel-art mascot, holding a tiny version of himself overhead next to a recycling bin"
        width="26"
        height="26"
        style="margin-right:0.4rem"
      />
      © {range} {SITE.author} ·
      <a href={SITE.license.url} target="_blank" rel="license noopener noreferrer">
        {SITE.license.label}
      </a>
      · <button type="button" class="link-button" data-cc="show-preferencesModal">Cookie preferences</button>
    </span>
    <span>SIGNAL LOCK: SCOTSCOTTMCA.COM</span>
  </div>
</footer>
