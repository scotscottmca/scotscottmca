---
import { SITE } from '../config';
const year = new Date().getFullYear();
const range = year > SITE.since ? `${SITE.since}–${year}` : `${SITE.since}`;
---

<footer class="site-footer">
  <div class="container">
    <img
      class="foot-mascot"
      src="/images/emotes/self.png"
      alt="Scott's pixel-art mascot, holding a tiny version of himself overhead next to a recycling bin"
      width="48"
      height="48"
    />
    <div class="foot-lines">
      <p>© {range} {SITE.author} · <a href={SITE.license.url} target="_blank" rel="license noopener noreferrer">{SITE.license.label}</a></p>
      <p>Built with Astro, served from Azure Static Web Apps.</p>
    </div>
    <nav class="foot-links" aria-label="Footer">
      <a href="/rss.xml">rss</a>
      <a href="/releases">releases</a>
      <button type="button" class="link-button" data-cc="show-preferencesModal">cookies</button>
      <a href="/id-10-t">id-10-t</a>
    </nav>
  </div>
</footer>
