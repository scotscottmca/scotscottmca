---
// The published release state of a project, read live from the npm registry.
// away-team ships from a GitHub Actions workflow on every push that touches an
// agent, a skill or the installer, so the registry — not the last site build —
// is the only honest source for "what version is out right now".
//
// The lamp ships unlit and only a real reading lights it; a failed read is a
// named state ("No signal") rather than a spinner or a guess.

import Icon from './Icon.astro';

interface Props {
  /** npm package name, e.g. "@scotscottmca/away-team". */
  pkg: string;
}

const { pkg } = Astro.props;
const npmUrl = `https://www.npmjs.com/package/${pkg}`;
---

<section class="release-state panel" data-release data-package={pkg} data-tone="down">
  <div class="panel-bar">
    <span class="release-head"><span class="lamp" data-release-led data-tone="down"></span>npm view</span>
    <span data-release-meta>{pkg}</span>
  </div>

  <div class="release-body" aria-live="polite">
    {/* Figures stay hidden until a reading arrives: no placeholder digits. */}
    <dl class="release-figures" hidden data-release-figures>
      <div><dt>latest</dt><dd data-release-version></dd></div>
      <div><dt>since publish</dt><dd data-release-age></dd></div>
      <div><dt>versions</dt><dd data-release-count></dd></div>
    </dl>

    <p class="release-note" data-release-note>Reading the registry…</p>

    {/* The last few versions, newest first. Collapses when there is nothing. */}
    <ol class="release-ladder" hidden data-release-ladder></ol>

    <a class="arrow-link" href={npmUrl} target="_blank" rel="noopener noreferrer">package on npm <Icon name="arrow-up-right" /></a>
  </div>
</section>

<script>
  const block = document.querySelector('[data-release]');
  if (block) {
    const pkg = block.dataset.package;
    const led = block.querySelector('[data-release-led]');
    const meta = block.querySelector('[data-release-meta]');
    const figures = block.querySelector('[data-release-figures]');
    const note = block.querySelector('[data-release-note]');
    const ladder = block.querySelector('[data-release-ladder]');
    const versionEl = block.querySelector('[data-release-version]');
    const ageEl = block.querySelector('[data-release-age]');
    const countEl = block.querySelector('[data-release-count]');

    const DAY = 86_400_000;

    // Age as one compact figure, so the value stays a number plus a unit letter
    // rather than a sentence: 4h, 3d, 5w, 2y.
    function age(from) {
      const ms = Date.now() - from.getTime();
      if (ms < 3_600_000) return `${Math.max(1, Math.round(ms / 60_000))}m`;
      if (ms < DAY) return `${Math.round(ms / 3_600_000)}h`;
      if (ms < 14 * DAY) return `${Math.round(ms / DAY)}d`;
      if (ms < 365 * DAY) return `${Math.round(ms / (7 * DAY))}w`;
      return `${(ms / (365 * DAY)).toFixed(1)}y`;
    }

    const stamp = (d) =>
      d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

    const clock = (d) => d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });

    // Patch releases often land several times in a day, so a same-day entry
    // carries its time — otherwise the ladder would read as five identical rows.
    const rowStamp = (d) =>
      d.toDateString() === new Date().toDateString() ? `${stamp(d)} · ${clock(d)}` : stamp(d);

    function paint(data) {
      const latest = data['dist-tags']?.latest;
      const times = data.time || {};
      // Every published version, newest first. "created"/"modified" are registry
      // bookkeeping, not releases.
      const published = Object.keys(data.versions || {})
        .filter((v) => times[v])
        .map((v) => ({ version: v, date: new Date(times[v]) }))
        .sort((a, b) => b.date.getTime() - a.date.getTime());

      if (!latest || published.length === 0) return fail('Nothing published yet');

      const latestAt = new Date(times[latest] || published[0].date);

      versionEl.textContent = latest;
      ageEl.textContent = age(latestAt);
      countEl.textContent = String(published.length);
      figures.hidden = false;

      note.textContent = `${latest} published ${stamp(latestAt)}.`;
      block.dataset.tone = 'ok';
      led.dataset.tone = 'ok';

      ladder.replaceChildren(
        ...published.slice(0, 5).map(({ version, date }) => {
          const li = document.createElement('li');
          const v = document.createElement('span');
          v.className = 'release-ver';
          v.textContent = version;
          const d = document.createElement('span');
          d.className = 'release-date';
          d.textContent = rowStamp(date);
          li.append(v, d);
          return li;
        })
      );
      ladder.hidden = false;
      meta.textContent = `read ${clock(new Date())}`;
    }

    // An honest failure: the registry is unreachable, not "no releases exist".
    function fail(reason) {
      block.dataset.tone = 'down';
      led.dataset.tone = 'down';
      figures.hidden = true;
      ladder.hidden = true;
      ladder.replaceChildren();
      note.textContent = `No signal — ${reason}. The package page on npm still has the answer.`;
      meta.textContent = pkg;
    }

    async function read() {
      try {
        const res = await fetch(`https://registry.npmjs.org/${encodeURIComponent(pkg)}`, {
          headers: { accept: 'application/json' },
        });
        if (!res.ok) return fail(`the registry returned ${res.status}`);
        paint(await res.json());
      } catch {
        fail('could not reach the npm registry');
      }
    }

    read();
  }
</script>

<style>
  .release-state {
    margin-top: 56px;
    max-width: 70ch;
  }
  .release-head {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .lamp {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--faint);
  }
  .lamp[data-tone='ok'] {
    background: var(--cyan);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--cyan) 18%, transparent);
  }
  .release-body {
    padding: 20px;
  }
  .release-figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0 0 16px;
  }
  .release-figures[hidden] {
    display: none;
  }
  .release-figures dt {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .release-figures dd {
    margin: 4px 0 0;
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 700;
    color: var(--cyan);
    font-variant-numeric: tabular-nums;
  }
  .release-note {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 15px;
  }
  .release-ladder {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .release-ladder :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-top: 1px solid var(--line);
    font-variant-numeric: tabular-nums;
  }
  .release-ladder :global(.release-date) {
    color: var(--muted);
  }
</style>
