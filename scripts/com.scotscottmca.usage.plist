<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Publishes Claude + GitHub usage to the gist behind scotscottmca.com/usage
  every 15 minutes. Install it on every Mac you work on: each machine publishes
  its own usage-<device>.json to the same gist and the figures are summed. A
  second Mac needs this repo cloned, `gh auth login`, and node at the path
  below. On Windows the collector is the same script — only the scheduling
  differs; run scripts/usage-task.ps1 there instead of installing this.

  Install / reinstall:

    cp scripts/com.scotscottmca.usage.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u)/com.scotscottmca.usage 2>/dev/null
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.scotscottmca.usage.plist

  USAGE_CYCLE_DAY is the day of the month the Claude subscription renews; it
  sets where the billing-cycle window on the page starts. Keep it the same on
  every machine, or the merged figures will disagree about the cycle.

  Logs: /tmp/scotscottmca-usage.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.scotscottmca.usage</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/scott/Dev/scotscottmca/scripts/usage-stats.mjs</string>
    <string>--publish</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>USAGE_GIST_ID</key>
    <string>5321ac84ddec1de6e66f6f49f0f5d57f</string>
    <key>USAGE_CYCLE_DAY</key>
    <string>10</string>
  </dict>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/scotscottmca-usage.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/scotscottmca-usage.log</string>
</dict>
</plist>
