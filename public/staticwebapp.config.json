{
  "$schema": "https://json.schemas.azure.com/staticwebapp.config.json",
  "trailingSlash": "auto",
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "mimeTypes": {
    ".webp": "image/webp",
    ".json": "application/json",
    ".xml": "application/xml"
  },
  "globalHeaders": {
    "cache-control": "public, max-age=0, must-revalidate"
  },
  "routes": [
    {
      "route": "/api/status",
      "headers": {
        "cache-control": "no-store, max-age=0"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "cache-control": "public, max-age=604800, immutable"
      }
    },
    {
      "route": "/_astro/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ]
}
